---
// Three small line glyphs, one per machine type, as an SVG sprite. The fleet cards
// pick one with <use href="#glyph-desktop"> and so on, so the shapes are drawn once
// and the browser stamps them on every card.
---

<svg width="0" height="0" class="absolute" aria-hidden="true">
  <symbol id="glyph-desktop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="3" width="20" height="14" rx="2.5"></rect>
    <path d="M8 21h8M12 17v4"></path>
  </symbol>
  <symbol id="glyph-laptop" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="4" y="4" width="16" height="11" rx="2"></rect>
    <path d="M2 19h20M4 15l-1.5 4M20 15l1.5 4"></path>
  </symbol>
  <symbol id="glyph-aio" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="2" width="18" height="16" rx="2.5"></rect>
    <path d="M3 14h18M12 18v3M7 21h10"></path>
  </symbol>
</svg>
