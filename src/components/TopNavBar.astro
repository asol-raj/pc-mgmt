---
import { Search, ListChecks } from '@lucide/astro';
---

<header class="sticky top-0 z-10 bg-white border-b border-slate-200 px-6 py-4 flex items-center gap-4">
  <div class="relative flex-1 max-w-md">
    <Search size={16} class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
    <input
      type="text"
      x-model="search"
      placeholder="Search by name, asset tag, location, extension, TeamViewer ID..."
      class="w-full rounded-lg border border-slate-300 pl-9 pr-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400"
    />
  </div>

  <div class="flex items-center gap-1.5 text-sm text-slate-500 whitespace-nowrap">
    <ListChecks size={15} class="text-slate-400" />
    Showing <span class="font-semibold text-slate-900" x-text="filtered.length"></span>
    of <span class="font-semibold text-slate-900" x-text="pcs.length"></span> PCs
  </div>
</header>
