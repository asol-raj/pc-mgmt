---
import { MonitorCog, House, ShieldCheck, RotateCcw } from '@lucide/astro';
---

<aside class="w-64 shrink-0 border-r border-slate-200 bg-white flex flex-col overflow-y-auto">
  <div class="px-6 py-6 border-b border-slate-200 flex items-center gap-2.5">
    <div class="w-9 h-9 rounded-lg bg-indigo-600 text-white flex items-center justify-center shrink-0">
      <MonitorCog size={20} />
    </div>
    <div>
      <p class="text-[11px] font-semibold uppercase tracking-wider text-indigo-500 leading-none">Office IT</p>
      <h1 class="text-lg font-bold text-slate-900 leading-tight">PC Register</h1>
    </div>
  </div>

  <nav class="px-4 py-4 border-b border-slate-200 flex flex-col gap-1">
    <a
      href="/"
      class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium bg-indigo-50 text-indigo-700"
    >
      <House size={16} />
      Home
    </a>
    <a
      href="/admin"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium text-slate-600 hover:bg-slate-50 hover:text-slate-900"
    >
      <ShieldCheck size={16} />
      Admin
    </a>
  </nav>

  <div class="px-4 py-4 border-b border-slate-200">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-2">Overview</p>
    <div class="grid grid-cols-3 gap-2 text-center">
      <div class="rounded-lg bg-slate-50 py-2">
        <p class="text-lg font-bold text-slate-900" x-text="totalCount"></p>
        <p class="text-[10px] font-medium text-slate-500">Total</p>
      </div>
      <div class="rounded-lg bg-emerald-50 py-2">
        <p class="text-lg font-bold text-emerald-700" x-text="activeCount"></p>
        <p class="text-[10px] font-medium text-emerald-600">Active</p>
      </div>
      <div class="rounded-lg bg-rose-50 py-2">
        <p class="text-lg font-bold text-rose-700" x-text="retiredCount"></p>
        <p class="text-[10px] font-medium text-rose-600">Retired</p>
      </div>
    </div>
  </div>

  <div class="px-4 py-4 flex flex-col gap-2 flex-1">
    <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">Tip</p>
    <p class="text-xs text-slate-500 leading-relaxed">
      Sort and filter any column directly from its header in the table.
    </p>

    <button
      type="button"
      x-on:click="resetFilters()"
      class="mt-2 flex items-center gap-1.5 text-sm font-medium text-indigo-600 hover:text-indigo-800"
    >
      <RotateCcw size={14} />
      Reset filters &amp; sorting
    </button>
  </div>
</aside>
