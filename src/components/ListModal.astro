---
// One PC's installed programs or printers, as a plain grid in a centered window:
// gridlines both ways, a bold heading row, sorted by name, with a filter box for the
// PC that has two hundred entries. Both lists share this one component; which
// columns it shows comes from the list spec in pcTable.js.
import { X, ArrowUp, ArrowDown, Search, ListX } from '@lucide/astro';

const head =
  'sticky top-0 z-10 bg-slate-100 border-b border-r border-slate-300 px-2.5 py-1.5 text-left text-[11px] font-bold text-slate-700 whitespace-nowrap select-none';
const cell = 'border-b border-r border-slate-200 px-2.5 py-1 text-[12px] align-top';
---

<template x-if="listModal">
  <div class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4">
    <div class="absolute inset-0" x-on:click="closeList()"></div>

    <div class="relative flex w-full max-w-4xl max-h-[88vh] flex-col overflow-hidden rounded-xl bg-white shadow-2xl">
      <!-- Title bar -->
      <div class="flex shrink-0 items-center justify-between gap-3 border-b border-slate-200 px-4 py-2.5">
        <div class="min-w-0">
          <h2 class="text-[14px] font-bold text-slate-900 truncate">
            <span x-text="listModal.spec.title"></span>
            <span class="font-normal text-slate-400"> — </span>
            <span class="font-semibold text-indigo-700" x-text="listModal.pc.name"></span>
          </h2>
        </div>

        <div class="flex shrink-0 items-center gap-2">
          <label class="relative">
            <Search size={12} class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-slate-400" />
            <input
              type="text"
              x-model="listModal.filter"
              x-init="$nextTick(() => $el.focus())"
              placeholder="Filter…"
              class="w-48 rounded-md border border-slate-300 py-1 pl-6 pr-2 text-[12px] focus:outline-none focus:ring-2 focus:ring-indigo-300"
            />
          </label>
          <button type="button" x-on:click="closeList()" class="rounded p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700">
            <X size={16} />
          </button>
        </div>
      </div>

      <!-- The grid -->
      <div class="min-h-0 flex-1 overflow-auto">
        <table class="w-full min-w-max border-separate border-spacing-0 border-l border-slate-200">
          <thead>
            <tr>
              <th class={`${head} w-10 text-right`}>#</th>
              <template x-for="col in listModal.spec.columns" :key="col.key">
                <th class={head} :class="col.align === 'right' ? 'text-right' : ''">
                  <button type="button" x-on:click="listSort(col.key)" class="flex items-center gap-1 hover:text-indigo-700">
                    <span x-text="col.label"></span>
                    <ArrowUp size={10} x-show="listModal.sortKey === col.key && listModal.sortDir === 'asc'" class="text-indigo-600" />
                    <ArrowDown size={10} x-show="listModal.sortKey === col.key && listModal.sortDir === 'desc'" class="text-indigo-600" />
                  </button>
                </th>
              </template>
            </tr>
          </thead>

          <tbody>
            <template x-for="(row, i) in listRows" :key="row.id ?? i">
              <tr class="hover:bg-indigo-50/40">
                <td class={`${cell} text-right tabular-nums text-slate-400`} x-text="i + 1"></td>
                <template x-for="col in listModal.spec.columns" :key="col.key">
                  <td
                    class={cell}
                    :class="[
                      col.strong ? 'font-semibold text-slate-900' : 'text-slate-700',
                      col.mono ? 'font-mono text-[11px]' : '',
                      col.align === 'right' ? 'text-right tabular-nums' : '',
                      col.muted && listText(col, row) === '' ? 'text-slate-300' : '',
                    ]"
                    x-text="listText(col, row)"
                  ></td>
                </template>
              </tr>
            </template>
          </tbody>
        </table>

        <div x-show="listModal.loading" class="px-4 py-8 text-center text-[12px] text-slate-400">Loading…</div>
        <div x-show="listModal.error" x-cloak class="px-4 py-8 text-center text-[12px] text-rose-600" x-text="listModal.error"></div>
        <div
          x-show="!listModal.loading && !listModal.error && listRows.length === 0"
          x-cloak
          class="flex flex-col items-center gap-1.5 px-4 py-8 text-center text-[12px] text-slate-400"
        >
          <ListX size={20} class="text-slate-300" />
          <span x-text="listModal.filter ? 'Nothing matches the filter.' : 'Nothing reported for this PC.'"></span>
        </div>
      </div>

      <!-- Status bar -->
      <div class="flex shrink-0 items-center justify-between border-t border-slate-200 bg-slate-50 px-4 py-1.5 text-[11px] text-slate-500">
        <span>
          <span x-text="listRows.length"></span>
          <span x-show="listModal.filter"> of <span x-text="listModal.rows.length"></span></span>
          <span x-text="' ' + listModal.spec.noun"></span>
        </span>
        <span x-text="listModal.spec.hint"></span>
      </div>
    </div>
  </div>
</template>
