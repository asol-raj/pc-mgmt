---
// Admin-side detail panel: the whole record of the selected row, as plain
// label/value rows. Deliberately unstyled compared to the public VitalsPane —
// this is a work surface, not a display card.
import { MousePointerClick, Pencil, RotateCw, Trash2 } from '@lucide/astro';
---

<aside class="w-96 shrink-0 flex flex-col rounded-xl border border-slate-200 bg-white overflow-hidden">
  <template x-if="!selected">
    <div class="h-full flex flex-col items-center justify-center p-8 text-center gap-3">
      <MousePointerClick size={24} class="text-slate-300" />
      <p class="text-slate-400 text-sm">Select a row to see the full record here.</p>
    </div>
  </template>

  <template x-if="selected">
    <div class="flex flex-col min-h-0">
      <div class="flex items-start justify-between gap-3 px-4 py-3 border-b border-slate-200 bg-slate-50 shrink-0">
        <div class="min-w-0">
          <p class="text-sm font-bold text-slate-900 truncate" x-text="selected.name"></p>
          <p class="text-xs text-slate-500 font-mono truncate" x-text="selected.asset_tag"></p>
        </div>
        <div class="flex items-center gap-1.5 shrink-0">
          <button
            type="button"
            x-on:click="openEdit(selected)"
            title="Edit this PC"
            class="flex items-center gap-1.5 rounded-lg border border-slate-300 bg-white text-slate-700 text-xs font-semibold px-2.5 py-1.5 hover:bg-slate-100"
          >
            <Pencil size={12} />
            Edit
          </button>
          <button
            type="button"
            x-on:click="toggleStatus(selected)"
            :title="selected.status === 'Active' ? 'Retire this PC' : 'Reactivate this PC'"
            class="rounded-lg border border-slate-300 bg-white text-slate-600 p-1.5 hover:bg-slate-100 hover:text-indigo-700"
          >
            <RotateCw size={14} />
          </button>
          <button
            type="button"
            x-on:click="remove(selected)"
            title="Delete this PC"
            class="rounded-lg border border-slate-300 bg-white text-rose-600 p-1.5 hover:bg-rose-50 hover:border-rose-300"
          >
            <Trash2 size={14} />
          </button>
        </div>
      </div>

      <div class="overflow-y-auto px-4 min-h-0">
        <template x-for="field in detailFields" :key="field.key">
          <div class="flex items-start justify-between gap-3 py-2 border-b border-slate-100 last:border-0">
            <span class="text-xs text-slate-500 w-28 shrink-0 pt-0.5" x-text="field.label"></span>

            <template x-if="field.badge">
              <span
                class="rounded-full px-2 py-0.5 text-xs font-semibold shrink-0"
                :class="field.badge === 'status' ? statusBadgeClass(selected.status) : performanceBadgeClass(selected.performance)"
                x-text="detailValue(field, selected)"
              ></span>
            </template>
            <template x-if="!field.badge">
              <span
                class="text-sm font-medium text-slate-900 text-right break-words min-w-0 max-h-32 overflow-y-auto"
                x-text="detailValue(field, selected)"
              ></span>
            </template>
          </div>
        </template>
      </div>
    </div>
  </template>
</aside>
