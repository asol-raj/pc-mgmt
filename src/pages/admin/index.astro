---
import Layout from '../../layouts/Layout.astro';
import TopBar from '../../components/TopBar.astro';
import RegisterTable from '../../components/RegisterTable.astro';
import DataTable from '../../components/DataTable.astro';
import RecordDrawer from '../../components/RecordDrawer.astro';
import db from '../../lib/db';
import type { Pc } from '../../lib/types';
import {
  ExternalLink,
  LogOut,
  Plus,
  MonitorX,
  X,
  Check,
  Download,
  Upload,
  WandSparkles,
  ClipboardCopy,
} from '@lucide/astro';

const [rows] = await db.query('SELECT * FROM pcs ORDER BY name ASC');
const pcs = rows as Pc[];

const label = 'text-[11px] font-semibold text-slate-500';
const field = 'rounded-lg border border-slate-300 px-3 py-2 text-[13px] focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-indigo-400';
---

<Layout title="Admin — PC Register">
  <div class="flex flex-col h-screen overflow-hidden bg-slate-50" x-data="adminApp()" x-cloak>
    <TopBar eyebrow="Office IT" title="Admin Dashboard" admin>
      <button
        type="button"
        x-show="view === 'data'"
        x-on:click="copyTsv()"
        title="Copy the visible rows — paste straight into Excel or Google Sheets"
        class="flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1.5 text-[12px] font-semibold text-slate-600 hover:bg-slate-50"
      >
        <ClipboardCopy size={13} x-show="!copied" />
        <Check size={13} x-show="copied" class="text-emerald-600" />
        <span x-text="copied ? 'Copied' : 'Copy'"></span>
      </button>

      <a
        href="/api/pcs/export"
        title="Download every PC as CSV"
        class="flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1.5 text-[12px] font-semibold text-slate-600 hover:bg-slate-50"
      >
        <Download size={13} />
        Export
      </a>

      <label
        title="Upload a CSV — rows are matched on asset tag and updated, or created"
        class="flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1.5 text-[12px] font-semibold text-slate-600 hover:bg-slate-50 cursor-pointer"
        :class="importing ? 'opacity-60 pointer-events-none' : ''"
      >
        <Upload size={13} />
        <span x-text="importing ? 'Importing…' : 'Import'"></span>
        <input type="file" accept=".csv,text/csv" class="hidden" x-on:change="importCsv($event)" />
      </label>

      <button
        type="button"
        x-on:click="openCreate()"
        class="flex items-center gap-1.5 rounded-lg bg-indigo-600 px-3 py-1.5 text-[12px] font-semibold text-white hover:bg-indigo-700"
      >
        <Plus size={13} />
        Add PC
      </button>

      <div class="h-6 w-px bg-slate-200"></div>

      <a href="/" target="_blank" rel="noopener noreferrer" title="Open the public register" class="text-slate-400 hover:text-slate-700">
        <ExternalLink size={15} />
      </a>
      <button type="button" x-on:click="logout()" title="Log out" class="text-slate-400 hover:text-rose-600">
        <LogOut size={15} />
      </button>
    </TopBar>

    <main class="flex-1 min-h-0 flex flex-col p-3 gap-3">
      <template x-if="importResult">
        <div
          class="rounded-lg border px-3 py-2 text-[13px] flex items-start justify-between gap-4 shrink-0"
          :class="importResult.error ? 'border-rose-200 bg-rose-50 text-rose-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700'"
        >
          <div class="flex-1">
            <template x-if="importResult.error">
              <p x-text="importResult.error"></p>
            </template>
            <template x-if="!importResult.error">
              <div>
                <p>
                  Import complete: <span x-text="importResult.created"></span> created,
                  <span x-text="importResult.updated"></span> updated<span x-show="importResult.errors?.length">,
                  <span x-text="importResult.errors.length"></span> failed</span>.
                </p>
                <ul class="mt-1 list-disc list-inside text-[11px] text-rose-700" x-show="importResult.errors?.length">
                  <template x-for="err in importResult.errors.slice(0, 10)" :key="err.row">
                    <li x-text="`Row ${err.row}: ${err.error}`"></li>
                  </template>
                </ul>
              </div>
            </template>
          </div>
          <button type="button" x-on:click="importResult = null" class="text-slate-400 hover:text-slate-700 shrink-0">
            <X size={15} />
          </button>
        </div>
      </template>

      <template x-if="filtered.length === 0">
        <div class="flex-1 flex flex-col items-center justify-center gap-2 text-center">
          <MonitorX size={26} class="text-slate-300" />
          <p class="text-sm text-slate-500" x-text="pcs.length ? 'No PCs match the current search or filters.' : 'No PCs in the register yet.'"></p>
          <button
            type="button"
            x-on:click="pcs.length ? resetFilters() : openCreate()"
            class="text-[13px] font-semibold text-indigo-600 hover:text-indigo-800"
            x-text="pcs.length ? 'Clear everything' : 'Add the first PC'"
          ></button>
        </div>
      </template>

      <template x-if="filtered.length > 0 && view === 'register'">
        <RegisterTable admin />
      </template>

      <template x-if="filtered.length > 0 && view === 'data'">
        <DataTable admin />
      </template>
    </main>

    <footer class="shrink-0 border-t border-slate-200 bg-white px-4 py-1.5 text-[11px] text-slate-400">
      <span x-show="view === 'register'">
        Click a PC name for its full record · Used By and Location edit in place — Enter saves, Esc cancels · Switch to
        Data to edit every admin-owned field
      </span>
      <span x-show="view === 'data'" x-cloak>
        Columns with a highlighted heading are yours to edit — click a cell, Enter saves, Esc cancels · The rest are
        overwritten by the agent app on its next report
      </span>
    </footer>

    <RecordDrawer admin />

    <!-- An inline edit that failed: the row kept its old value -->
    <div
      x-show="toast"
      x-cloak
      class="fixed bottom-5 right-5 z-50 max-w-sm rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-[13px] text-rose-700 shadow-lg flex items-start gap-3"
    >
      <span class="flex-1" x-text="toast"></span>
      <button type="button" x-on:click="toast = null" class="text-rose-400 hover:text-rose-700 shrink-0">
        <X size={14} />
      </button>
    </div>

    <!-- Add / Edit modal. Dismissed only via Cancel or the X, so a stray click never discards a filled-in form. -->
    <div x-show="modalOpen" x-cloak class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/40 p-4">
      <div class="w-full max-w-4xl max-h-[92vh] overflow-y-auto rounded-2xl bg-white p-7">
        <div class="flex items-center justify-between">
          <h2 class="text-lg font-bold text-slate-900" x-text="form.id ? 'Edit PC' : 'Add New PC'"></h2>
          <button type="button" x-on:click="closeModal()" class="text-slate-400 hover:text-slate-700">
            <X size={18} />
          </button>
        </div>

        <form class="mt-5 flex flex-col gap-4" x-on:submit.prevent="save()">
          <div class="flex flex-col gap-2 rounded-lg border border-dashed border-slate-300 bg-slate-50 p-3">
            <span class="text-[11px] text-slate-500">
              Paste the output of the Windows <code>systeminfo</code> command to auto-fill Name, Brand, CPU, RAM, OS,
              Windows edition and IP details
            </span>
            <textarea
              x-model="systemInfoText"
              rows="3"
              placeholder="Host Name:                 DESKTOP-AB12CD3&#10;OS Name:                   Microsoft Windows 11 Pro&#10;..."
              class="rounded-lg border border-slate-300 px-3 py-2 text-[11px] font-mono"></textarea>
            <div class="flex items-center justify-between gap-2">
              <p
                class="text-[11px]"
                :class="systemInfoApplied?.startsWith('No') ? 'text-amber-600' : 'text-emerald-600'"
                x-show="systemInfoApplied"
                x-text="systemInfoApplied"
              >
              </p>
              <button
                type="button"
                x-on:click="applySystemInfo()"
                class="ml-auto flex shrink-0 items-center gap-1.5 rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-[11px] font-semibold text-slate-700 hover:bg-slate-100"
              >
                <WandSparkles size={12} />
                Parse &amp; Fill
              </button>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>Asset Tag *</span>
              <input type="text" x-model="form.asset_tag" required class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>PC Name *</span>
              <input type="text" x-model="form.name" required class={field} />
            </label>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>Location *</span>
              <input type="text" x-model="form.location" required placeholder="e.g. 2nd Floor — Accounts" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Used By</span>
              <input type="text" x-model="form.used_by" placeholder="Person at this desk" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Extension Number</span>
              <input type="text" x-model="form.extension_number" class={field} />
            </label>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>Brand</span>
              <input type="text" x-model="form.brand" placeholder="e.g. Dell, HP, Lenovo" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Machine Type</span>
              <select x-model="form.machine_type" class={field}>
                <option value="Desktop">Desktop</option>
                <option value="Laptop">Laptop</option>
                <option value="AIO">AIO</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Condition</span>
              <select x-model="form.condition_status" class={field}>
                <option value="New">New</option>
                <option value="Refurbished">Refurbished</option>
              </select>
            </label>
          </div>

          <div class="grid grid-cols-4 gap-3">
            <label class="flex flex-col gap-1 col-span-2">
              <span class={label}>CPU</span>
              <input type="text" x-model="form.cpu" placeholder="e.g. Intel i5-13400" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>RAM (GB)</span>
              <input type="number" min="0" x-model="form.ram_gb" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Storage Capacity</span>
              <input type="text" x-model="form.storage_capacity" placeholder="e.g. 256GB, 1TB" class={field} />
            </label>
          </div>

          <div class="grid grid-cols-3 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>OS</span>
              <select x-model="form.os" class={field}>
                <option value="Windows 10">Windows 10</option>
                <option value="Windows 11">Windows 11</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Windows Edition</span>
              <select x-model="form.os_edition" class={field}>
                <option value="">—</option>
                <option value="Home">Home</option>
                <option value="Pro">Pro</option>
                <option value="Enterprise">Enterprise</option>
                <option value="Education">Education</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Storage Type</span>
              <select x-model="form.storage_type" class={field}>
                <option value="">—</option>
                <option value="SSD">SSD</option>
                <option value="HDD">HDD</option>
              </select>
            </label>
          </div>

          <div class="grid grid-cols-4 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>TeamViewer ID</span>
              <input type="text" x-model="form.teamviewer_id" class={field} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>IP Address</span>
              <input type="text" x-model="form.ip_address" placeholder="e.g. 192.168.1.57" class={`${field} font-mono`} />
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>IP Configuration</span>
              <select x-model="form.ip_config" class={field}>
                <option value="">—</option>
                <option value="Static">Static</option>
                <option value="Dynamic">Dynamic (DHCP)</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Login Accounts</span>
              <input type="text" x-model="form.assigned_users" placeholder="Windows accounts, comma separated" class={field} />
            </label>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <label class="flex flex-col gap-1">
              <span class={label}>Status</span>
              <select x-model="form.status" class={field}>
                <option value="Active">Active</option>
                <option value="Retired">Retired</option>
              </select>
            </label>
            <label class="flex flex-col gap-1">
              <span class={label}>Performance</span>
              <select x-model="form.performance" class={field}>
                <option value="Slow">Slow</option>
                <option value="Average">Average</option>
                <option value="Good">Good</option>
                <option value="Excellent">Excellent</option>
              </select>
            </label>
          </div>

          <label class="flex flex-col gap-1">
            <span class={label}>Softwares Installed</span>
            <textarea
              x-model="form.softwares"
              rows="2"
              placeholder="Comma separated, e.g. Office 365, Google Chrome, Adobe Reader"
              class={field}></textarea>
          </label>

          <label class="flex flex-col gap-1">
            <span class={label}>Comments</span>
            <textarea x-model="form.comments" rows="2" placeholder="Anything worth noting about this PC" class={field}
            ></textarea>
          </label>

          <p class="text-[13px] text-rose-600" x-show="formError" x-text="formError"></p>

          <div class="mt-1 flex items-center justify-end gap-3">
            <button type="button" x-on:click="closeModal()" class="text-[13px] font-semibold text-slate-500 hover:text-slate-800">
              Cancel
            </button>
            <button
              type="submit"
              :disabled="saving"
              class="flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2 text-[13px] font-semibold text-white hover:bg-indigo-700 disabled:opacity-60"
            >
              <Check size={14} x-show="!saving" />
              <span x-text="saving ? 'Saving…' : 'Save'"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script type="application/json" id="pcs-data" set:html={JSON.stringify(pcs)} />

  <script>
    import Alpine from 'alpinejs';
    import adminApp from '../../scripts/adminApp.js';

    window.adminApp = adminApp;
    window.Alpine = Alpine;
    Alpine.start();
  </script>
</Layout>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
