---
// The client-facing overview: the same PCs as the register, presented as a
// dashboard — a banner, the headline numbers, a few charts, and the fleet as
// cards — rather than as a sheet. Clicking a card opens the same record drawer
// the register uses, so nothing here is a second copy of that logic.
import Layout from '../layouts/Layout.astro';
import RecordDrawer from '../components/RecordDrawer.astro';
import ListModal from '../components/ListModal.astro';
import FleetIllustration from '../components/dashboard/FleetIllustration.astro';
import MachineGlyphs from '../components/dashboard/MachineGlyphs.astro';
import DonutChart from '../components/dashboard/DonutChart.astro';
import BarList from '../components/dashboard/BarList.astro';
import {
  LayoutDashboard,
  Monitor,
  HeartPulse,
  MapPin,
  Search,
  Table2,
  ShieldCheck,
  ArrowRight,
  Activity,
  Cpu,
  MemoryStick,
  AlertTriangle,
  CheckCircle2,
  Radio,
  User,
  Package,
  Printer,
  Mic,
  Camera,
  Volume2,
  SearchX,
  ChevronRight,
} from '@lucide/astro';
import { listPcs } from '../lib/pcs';
import { fleetStats, relativeTime } from '../lib/fleetStats.js';
import type { Pc } from '../lib/types';

const pcs: Pc[] = await listPcs();
const stats = fleetStats(pcs);

const pct = (share: number) => `${Math.round(share * 100)}%`;
const today = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
const lastReport = relativeTime(stats.latestReport);

const typeSummary = stats.byType.map((t) => `${t.count} ${t.label === 'AIO' ? 'all-in-one' : t.label.toLowerCase()}${t.count === 1 ? '' : 's'}`).join(' · ');

// One card per location, with what stands at that location.
const locations = stats.byLocation.map((loc) => {
  const rows = pcs.filter((pc) => (pc.location?.trim() || 'Unassigned') === loc.label);
  const of = (test: (pc: Pc) => boolean) => rows.filter(test).length;
  return {
    ...loc,
    active: of((pc) => pc.status === 'Active'),
    desktops: of((pc) => pc.machine_type === 'Desktop'),
    aios: of((pc) => pc.machine_type === 'AIO'),
    laptops: of((pc) => pc.machine_type === 'Laptop'),
    users: of((pc) => Boolean(pc.used_by?.trim())),
    names: rows.map((pc) => pc.name).sort().slice(0, 6),
    more: Math.max(0, rows.length - 6),
  };
});

// Multimedia, from the PCs whose agent has reported it.
const reportedMedia = pcs.filter((pc) => pc.audio_output || pc.microphone || pc.camera);
const media = [
  { label: 'Speakers', Icon: Volume2, working: reportedMedia.filter((pc) => pc.audio_output === 'Working').length },
  { label: 'Microphones', Icon: Mic, working: reportedMedia.filter((pc) => pc.microphone === 'Working').length },
  { label: 'Cameras', Icon: Camera, working: reportedMedia.filter((pc) => pc.camera === 'Working').length },
];

const nav = [
  { href: '#overview', label: 'Overview', Icon: LayoutDashboard },
  { href: '#fleet', label: 'Fleet', Icon: Monitor },
  { href: '#health', label: 'Health', Icon: HeartPulse },
  { href: '#locations', label: 'Locations', Icon: MapPin },
];

const kpis = [
  {
    label: 'PCs in service',
    value: stats.total,
    note: typeSummary,
    Icon: Monitor,
    tone: 'bg-indigo-50 text-indigo-600',
  },
  {
    label: 'Active',
    value: stats.active,
    note: stats.retired ? `${stats.retired} retired` : 'None retired',
    Icon: Activity,
    tone: 'bg-emerald-50 text-emerald-600',
  },
  {
    label: 'On Windows 11',
    value: pct(stats.windows11Share),
    note: `${stats.windows11} of ${stats.total} PCs`,
    ring: stats.byOs,
  },
  {
    label: 'On SSD storage',
    value: pct(stats.ssdShare),
    note: `${stats.ssd} of ${stats.total} PCs`,
    ring: stats.byStorage,
  },
  {
    label: 'Total memory',
    value: `${stats.totalRamGb} GB`,
    note: `about ${stats.avgRamGb} GB per PC`,
    Icon: MemoryStick,
    tone: 'bg-violet-50 text-violet-600',
  },
  {
    label: 'Need attention',
    value: stats.attention.length,
    note: stats.attention.length ? 'see Health below' : 'everything checks out',
    Icon: stats.attention.length ? AlertTriangle : CheckCircle2,
    tone: stats.attention.length ? 'bg-amber-50 text-amber-600' : 'bg-emerald-50 text-emerald-600',
  },
];

const card = 'rounded-2xl border border-slate-200/80 bg-white shadow-[0_1px_2px_rgba(15,23,42,0.04),0_8px_24px_-12px_rgba(15,23,42,0.12)]';
const sectionTitle = 'text-lg font-bold tracking-tight text-slate-900';
const eyebrow = 'text-[11px] font-semibold uppercase tracking-[0.12em] text-indigo-600';
---

<Layout title="Fleet Overview · PC Register">
  <div class="min-h-screen bg-slate-50 text-slate-900 lg:grid lg:grid-cols-[240px_minmax(0,1fr)]" x-data="dashboardApp()" x-cloak>
    <MachineGlyphs />

    <!-- Sidebar -->
    <aside class="hidden lg:flex sticky top-0 h-screen flex-col bg-slate-950 text-slate-300">
      <div class="flex items-center gap-3 px-5 pt-6 pb-5">
        <svg viewBox="0 0 40 40" class="h-10 w-10 shrink-0" aria-hidden="true">
          <defs>
            <linearGradient id="brand-g" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#6366f1"></stop>
              <stop offset="1" stop-color="#7c3aed"></stop>
            </linearGradient>
          </defs>
          <rect width="40" height="40" rx="11" fill="url(#brand-g)"></rect>
          <rect x="8" y="10" width="24" height="16" rx="3" fill="#ffffff"></rect>
          <rect x="11" y="13" width="18" height="10" rx="1.5" fill="#4f46e5" fill-opacity="0.25"></rect>
          <rect x="17" y="26" width="6" height="3" fill="#ffffff"></rect>
          <rect x="13" y="29" width="14" height="3" rx="1.5" fill="#ffffff"></rect>
          <circle cx="31" cy="11" r="5" fill="#10b981" stroke="#0f172a" stroke-width="2"></circle>
        </svg>
        <div class="leading-tight">
          <p class="text-[15px] font-bold text-white">PC Register</p>
          <p class="text-[11px] font-medium text-slate-400">Office IT · Fleet</p>
        </div>
      </div>

      <nav class="px-3 mt-2">
        <p class="px-3 pb-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500">Overview</p>
        <ul class="space-y-0.5">
          {
            nav.map(({ href, label, Icon }) => (
              <li>
                <a
                  href={href}
                  class="group flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-semibold text-slate-300 hover:bg-white/5 hover:text-white"
                >
                  <Icon size={16} class="text-slate-500 group-hover:text-indigo-300" />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>

        <p class="px-3 pt-6 pb-2 text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-500">Tools</p>
        <ul class="space-y-0.5">
          <li>
            <a href="/" class="group flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-semibold text-slate-300 hover:bg-white/5 hover:text-white">
              <Table2 size={16} class="text-slate-500 group-hover:text-indigo-300" />
              Classic register
            </a>
          </li>
          <li>
            <a
              href="/admin"
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-lg px-3 py-2 text-[13px] font-semibold text-slate-300 hover:bg-white/5 hover:text-white"
            >
              <ShieldCheck size={16} class="text-slate-500 group-hover:text-indigo-300" />
              Admin
            </a>
          </li>
        </ul>
      </nav>

      <div class="mt-auto p-4">
        <div class="rounded-xl border border-white/10 bg-white/5 p-4">
          <div class="flex items-center gap-3">
            <DonutChart
              slices={[
                { label: 'Active', count: stats.active, share: stats.total ? stats.active / stats.total : 0, color: '#10b981' },
                { label: 'Retired', count: stats.retired, share: stats.total ? stats.retired / stats.total : 0, color: '#f43f5e' },
              ]}
              caption="Active share"
              size={48}
              thickness={7}
            />
            <div class="leading-tight">
              <p class="text-[20px] font-extrabold text-white tabular-nums">{pct(stats.total ? stats.active / stats.total : 0)}</p>
              <p class="text-[11px] text-slate-400">of the fleet is active</p>
            </div>
          </div>
          <p class="mt-3 text-[11px] leading-relaxed text-slate-400">
            {lastReport ? `Last agent report ${lastReport}.` : 'No agent reports yet.'}
          </p>
        </div>
      </div>
    </aside>

    <!-- Main column -->
    <div class="min-w-0">
      <header class="sticky top-0 z-30 border-b border-slate-200/80 bg-white/85 backdrop-blur">
        <div class="mx-auto flex h-16 max-w-[1440px] items-center gap-3 px-4 lg:px-8">
          <a href="/dashboard" class="flex items-center gap-2.5 lg:hidden">
            <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-white"><Monitor size={16} /></span>
            <span class="text-[15px] font-bold">PC Register</span>
          </a>

          <div class="hidden lg:block">
            <p class="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-400">Office IT</p>
            <h1 class="text-[15px] font-bold leading-tight text-slate-900">Fleet Overview</h1>
          </div>

          <div class="flex-1"></div>

          <label class="relative w-full max-w-xs">
            <Search size={14} class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
            <input
              type="text"
              x-model="search"
              placeholder="Find a PC, user, desk, IP…"
              class="w-full rounded-full border border-slate-200 bg-slate-100/80 py-2 pl-9 pr-4 text-[13px] placeholder:text-slate-400 focus:border-indigo-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-200"
              x-on:keydown.enter="document.getElementById('fleet')?.scrollIntoView({ behavior: 'smooth' })"
            />
          </label>

          <a
            href="/"
            class="hidden sm:flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3.5 py-2 text-[12px] font-semibold text-slate-700 hover:border-slate-300 hover:bg-slate-50"
          >
            <Table2 size={14} />
            Register
          </a>
          <a
            href="/admin"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-1.5 rounded-full bg-slate-900 px-3.5 py-2 text-[12px] font-semibold text-white hover:bg-slate-700"
          >
            <ShieldCheck size={14} />
            Admin
          </a>
        </div>
      </header>

      <main class="mx-auto max-w-[1440px] space-y-10 px-4 py-6 lg:px-8 lg:py-8">
        <!-- Hero -->
        <section id="overview" class="relative overflow-hidden rounded-3xl bg-linear-to-br from-indigo-600 via-indigo-700 to-violet-800 text-white shadow-xl shadow-indigo-900/20">
          <div class="pointer-events-none absolute -right-24 -top-24 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
          <div class="pointer-events-none absolute -bottom-32 left-1/3 h-80 w-80 rounded-full bg-violet-400/20 blur-3xl"></div>

          <div class="relative grid items-center gap-8 p-7 md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:p-10">
            <div>
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-indigo-200">{today}</p>
              <h2 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight sm:text-4xl">
                Your office fleet,<br class="hidden sm:block" /> at a glance.
              </h2>
              <p class="mt-4 max-w-md text-[14px] leading-relaxed text-indigo-100">
                Every desktop, all-in-one and laptop in one place: who uses it, where it sits, what is inside it, and
                whether it needs a hand. Updated by the register and by each PC's own agent.
              </p>

              <div class="mt-6 flex flex-wrap items-center gap-3">
                <a
                  href="#fleet"
                  class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-[13px] font-bold text-indigo-700 shadow-sm hover:bg-indigo-50"
                >
                  Browse the fleet
                  <ArrowRight size={14} />
                </a>
                <a
                  href="#health"
                  class="inline-flex items-center gap-2 rounded-full border border-white/30 bg-white/10 px-4 py-2 text-[13px] font-semibold text-white hover:bg-white/15"
                >
                  <HeartPulse size={14} />
                  Health check
                </a>
              </div>

              <dl class="mt-8 grid max-w-md grid-cols-3 gap-4 border-t border-white/15 pt-5">
                <div>
                  <dt class="text-[11px] font-medium text-indigo-200">PCs</dt>
                  <dd class="text-2xl font-extrabold tabular-nums">{stats.total}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-medium text-indigo-200">Locations</dt>
                  <dd class="text-2xl font-extrabold tabular-nums">{stats.byLocation.length}</dd>
                </div>
                <div>
                  <dt class="text-[11px] font-medium text-indigo-200">Reporting in</dt>
                  <dd class="text-2xl font-extrabold tabular-nums">
                    {stats.reporting}<span class="text-sm font-semibold text-indigo-200"> / {stats.total}</span>
                  </dd>
                </div>
              </dl>
            </div>

            <FleetIllustration class="mx-auto w-full max-w-[520px] drop-shadow-[0_20px_40px_rgba(15,23,42,0.35)]" />
          </div>
        </section>

        <!-- Headline numbers -->
        <section class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-6">
          {
            kpis.map(({ Icon, ...kpi }) => (
              <div class={`${card} flex flex-col gap-3 p-4`}>
                <div class="flex items-start justify-between gap-2">
                  <p class="text-[12px] font-semibold text-slate-500">{kpi.label}</p>
                  {kpi.ring ? (
                    <DonutChart slices={kpi.ring} caption={kpi.label} size={34} thickness={6} />
                  ) : (
                    <span class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-lg ${kpi.tone}`}>
                      <Icon size={16} />
                    </span>
                  )}
                </div>
                <div>
                  <p class="text-[26px] font-extrabold leading-none tracking-tight tabular-nums text-slate-900">{kpi.value}</p>
                  <p class="mt-1.5 truncate text-[11.5px] text-slate-500" title={kpi.note}>
                    {kpi.note}
                  </p>
                </div>
              </div>
            ))
          }
        </section>

        <!-- Charts -->
        <section class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          <div class={`${card} p-5`}>
            <p class={eyebrow}>Machine types</p>
            <div class="mt-4 flex items-center gap-4">
              <DonutChart slices={stats.byType} value={stats.total} caption="PCs" size={112} thickness={13} />
              <ul class="flex-1 space-y-2.5">
                {
                  stats.byType.map((t) => (
                    <li class="flex items-center gap-2 text-[12.5px]">
                      <span class="h-2.5 w-2.5 rounded-full" style={`background:${t.color}`} />
                      <span class="flex-1 whitespace-nowrap text-slate-600">{t.label === 'AIO' ? 'All-in-one' : t.label}</span>
                      <span class="font-bold tabular-nums text-slate-900">{t.count}</span>
                      <span class="w-9 text-right text-[11px] tabular-nums text-slate-400">{pct(t.share)}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <div class={`${card} p-5`}>
            <p class={eyebrow}>Windows &amp; storage</p>
            <div class="mt-4 space-y-4">
              {
                [
                  { title: 'Operating system', slices: stats.byOs },
                  { title: 'Disk type', slices: stats.byStorage },
                ].map((group) => (
                  <div>
                    <p class="mb-1.5 text-[12px] font-semibold text-slate-700">{group.title}</p>
                    <div class="flex h-3 w-full overflow-hidden rounded-full bg-slate-100">
                      {group.slices.map((s) => (
                        <span style={`width:${s.share * 100}%;background:${s.color}`} title={`${s.label}: ${s.count}`} />
                      ))}
                    </div>
                    <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                      {group.slices.map((s) => (
                        <li class="flex items-center gap-1.5 text-[11.5px] text-slate-600">
                          <span class="h-2 w-2 rounded-full" style={`background:${s.color}`} />
                          {s.label}
                          <span class="font-bold tabular-nums text-slate-900">{s.count}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))
              }
              <div>
                <p class="mb-1.5 text-[12px] font-semibold text-slate-700">Memory</p>
                <ul class="flex flex-wrap gap-2">
                  {
                    stats.byRam.map((r) => (
                      <li class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1 text-[11.5px] text-slate-600">
                        <span class="font-bold text-slate-900">{r.count}</span> × {r.label}
                      </li>
                    ))
                  }
                </ul>
              </div>
            </div>
          </div>

          <div class={`${card} p-5`}>
            <p class={eyebrow}>By location</p>
            <div class="mt-4">
              <BarList slices={stats.byLocation} />
            </div>
          </div>

          <div class={`${card} p-5`}>
            <p class={eyebrow}>By brand</p>
            <div class="mt-4">
              <BarList slices={stats.byBrand} />
            </div>
            <div class="mt-5 grid grid-cols-2 gap-3 border-t border-slate-100 pt-4">
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-sky-50 text-sky-600"><Package size={15} /></span>
                <div class="leading-tight">
                  <p class="text-[15px] font-extrabold tabular-nums text-slate-900">{stats.softwareTotal}</p>
                  <p class="text-[11px] text-slate-500">programs recorded</p>
                </div>
              </div>
              <div class="flex items-center gap-2.5">
                <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-teal-50 text-teal-600"><Printer size={15} /></span>
                <div class="leading-tight">
                  <p class="text-[15px] font-extrabold tabular-nums text-slate-900">{stats.printerTotal}</p>
                  <p class="text-[11px] text-slate-500">printers recorded</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Fleet -->
        <section id="fleet" class="scroll-mt-20">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class={eyebrow}>Fleet</p>
              <h3 class={`${sectionTitle} mt-1`}>Every PC in the office</h3>
              <p class="mt-1 text-[13px] text-slate-500">Click a card to open its full record.</p>
            </div>
            <p class="text-[12.5px] text-slate-500 tabular-nums">
              Showing <span class="font-bold text-slate-900" x-text="cards.length"></span> of{' '}
              <span x-text="totalCount"></span>
            </p>
          </div>

          <div class="mt-4 flex flex-wrap gap-2">
            <template x-for="seg in segments" :key="seg.key">
              <button
                type="button"
                x-show="seg.count > 0 || seg.key === 'all'"
                x-on:click="segment = seg.key"
                class="flex items-center gap-1.5 rounded-full border px-3 py-1.5 text-[12px] font-semibold transition"
                :class="segment === seg.key ? 'border-indigo-600 bg-indigo-600 text-white shadow-sm' : 'border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:bg-slate-50'"
              >
                <span x-text="seg.label"></span>
                <span
                  class="rounded-full px-1.5 text-[10.5px] font-bold tabular-nums"
                  :class="segment === seg.key ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-500'"
                  x-text="seg.count"
                ></span>
              </button>
            </template>
          </div>

          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
            <template x-for="pc in cards" :key="pc.id">
              <button
                type="button"
                x-on:click="openRecord(pc)"
                class={`${card} group flex flex-col p-4 text-left transition hover:-translate-y-0.5 hover:border-indigo-300 hover:shadow-[0_12px_30px_-12px_rgba(79,70,229,0.35)] focus:outline-none focus:ring-2 focus:ring-indigo-300`}
              >
                <div class="flex items-start gap-3">
                  <span
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl"
                    :class="pc.machine_type === 'Laptop' ? 'bg-sky-50 text-sky-600' : pc.machine_type === 'AIO' ? 'bg-violet-50 text-violet-600' : 'bg-indigo-50 text-indigo-600'"
                  >
                    <svg class="h-5 w-5" aria-hidden="true"><use :href="'#glyph-' + String(pc.machine_type).toLowerCase()"></use></svg>
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-[14px] font-bold text-slate-900 group-hover:text-indigo-700" x-text="pc.name"></p>
                    <p class="truncate font-mono text-[11px] text-slate-500">
                      <span x-text="pc.asset_tag"></span>
                      <span x-show="pc.brand" class="text-slate-300"> · </span>
                      <span x-text="pc.brand" class="font-sans"></span>
                    </p>
                  </div>
                  <span
                    class="flex shrink-0 items-center gap-1.5 rounded-full px-2 py-0.5 text-[10.5px] font-bold ring-1 ring-inset"
                    :class="statusBadgeClass(pc.status)"
                  >
                    <span class="h-1.5 w-1.5 rounded-full" :class="pc.status === 'Active' ? 'bg-emerald-500' : 'bg-rose-500'"></span>
                    <span x-text="pc.status"></span>
                  </span>
                </div>

                <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2 text-[12px]">
                  <div class="flex min-w-0 items-center gap-1.5 text-slate-600">
                    <User size={13} class="shrink-0 text-slate-400" />
                    <span class="truncate" x-text="pc.used_by || 'Unassigned'" :class="pc.used_by ? '' : 'text-slate-400'"></span>
                  </div>
                  <div class="flex min-w-0 items-center gap-1.5 text-slate-600">
                    <MapPin size={13} class="shrink-0 text-slate-400" />
                    <span class="truncate">
                      <span x-text="pc.location"></span>
                      <span x-show="pc.extension_number" class="text-slate-400"> · ext <span x-text="pc.extension_number"></span></span>
                    </span>
                  </div>
                  <div class="col-span-2 flex min-w-0 items-center gap-1.5 text-slate-600">
                    <Cpu size={13} class="shrink-0 text-slate-400" />
                    <span class="truncate" x-text="shortCpu(pc.cpu) || 'CPU not recorded'" :title="pc.cpu"></span>
                  </div>
                </dl>

                <div class="mt-3 flex flex-wrap gap-1.5">
                  <template x-for="chip in specChips(pc)" :key="chip">
                    <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-medium text-slate-600" x-text="chip"></span>
                  </template>
                </div>

                <div class="mt-4 flex items-center justify-between gap-2 border-t border-slate-100 pt-3">
                  <span class="truncate font-mono text-[11px] text-slate-500">
                    <span x-text="pc.ip_address || 'No IP recorded'"></span>
                    <span x-show="pc.ip_config === 'Static'" class="ml-1 rounded bg-slate-100 px-1 font-sans text-[9.5px] font-bold uppercase tracking-wide text-slate-500">static</span>
                  </span>
                  <span class="flex shrink-0 items-center gap-1.5">
                    <span
                      x-show="reasonsFor(pc).length"
                      class="flex items-center gap-1 rounded-full bg-amber-50 px-1.5 py-0.5 text-[10.5px] font-bold text-amber-700 ring-1 ring-inset ring-amber-200"
                      :title="reasonsFor(pc).join(', ')"
                    >
                      <AlertTriangle size={10} />
                      <span x-text="reasonsFor(pc).length"></span>
                    </span>
                    <span class="rounded-full px-2 py-0.5 text-[10.5px] font-bold ring-1 ring-inset" :class="performanceBadgeClass(pc.performance)" x-text="pc.performance"></span>
                  </span>
                </div>
              </button>
            </template>
          </div>

          <div x-show="cards.length === 0" class={`${card} mt-5 flex flex-col items-center gap-2 px-6 py-14 text-center`}>
            <SearchX size={28} class="text-slate-300" />
            <p class="text-[14px] font-semibold text-slate-700">No PCs match that.</p>
            <p class="text-[12.5px] text-slate-500">Try a different name, user, desk or IP address, or clear the filter.</p>
            <button
              type="button"
              x-on:click="search = ''; segment = 'all'"
              class="mt-2 rounded-full bg-indigo-600 px-4 py-1.5 text-[12px] font-semibold text-white hover:bg-indigo-500"
            >
              Show everything
            </button>
          </div>
        </section>

        <!-- Health -->
        <section id="health" class="scroll-mt-20">
          <p class={eyebrow}>Health</p>
          <h3 class={`${sectionTitle} mt-1`}>What needs a hand</h3>

          <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)]">
            <div class={`${card} overflow-hidden`}>
              {
                stats.attention.length === 0 ? (
                  <div class="flex flex-col items-center gap-3 px-6 py-14 text-center">
                    <svg viewBox="0 0 96 96" class="h-24 w-24" aria-hidden="true">
                      <circle cx="48" cy="48" r="44" fill="#ecfdf5" />
                      <circle cx="48" cy="48" r="30" fill="#d1fae5" />
                      <circle cx="48" cy="48" r="18" fill="#10b981" />
                      <path d="M39 48.5 L45.5 55 L58 41.5" stroke="#ffffff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                    </svg>
                    <p class="text-[15px] font-bold text-slate-900">Every PC checks out</p>
                    <p class="max-w-sm text-[12.5px] leading-relaxed text-slate-500">
                      Nothing is retired, slow, out of support, on a hard disk, short on memory, or reporting a faulty
                      speaker, microphone or camera.
                    </p>
                  </div>
                ) : (
                  <ul class="divide-y divide-slate-100">
                    {stats.attention.map(({ pc, reasons }) => (
                      <li>
                        <button
                          type="button"
                          x-on:click={`openById(${pc.id})`}
                          class="flex w-full items-center gap-4 px-5 py-3.5 text-left hover:bg-slate-50"
                        >
                          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-amber-50 text-amber-600">
                            <AlertTriangle size={16} />
                          </span>
                          <span class="min-w-0 flex-1">
                            <span class="flex items-baseline gap-2">
                              <span class="truncate text-[13.5px] font-bold text-slate-900">{pc.name}</span>
                              <span class="truncate font-mono text-[11px] text-slate-400">{pc.asset_tag}</span>
                            </span>
                            <span class="mt-1 flex flex-wrap gap-1.5">
                              {reasons.map((reason) => (
                                <span class="rounded-md bg-amber-50 px-1.5 py-0.5 text-[11px] font-semibold text-amber-800 ring-1 ring-inset ring-amber-200">
                                  {reason}
                                </span>
                              ))}
                            </span>
                          </span>
                          <span class="hidden text-[12px] text-slate-500 sm:block">{pc.used_by || pc.location}</span>
                          <ChevronRight size={16} class="shrink-0 text-slate-300" />
                        </button>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>

            <div class="grid gap-4">
              <div class={`${card} p-5`}>
                <p class="text-[12px] font-semibold text-slate-700">Performance rating</p>
                <div class="mt-3">
                  <BarList slices={stats.byPerformance} />
                </div>
              </div>

              <div class={`${card} p-5`}>
                <div class="flex items-center justify-between">
                  <p class="text-[12px] font-semibold text-slate-700">Agent coverage</p>
                  <span class="flex items-center gap-1 text-[11px] font-semibold text-slate-500"><Radio size={12} /> {lastReport ?? 'never'}</span>
                </div>
                <div class="mt-3 flex items-center gap-4">
                  <DonutChart
                    slices={[
                      { label: 'Reporting', count: stats.reporting, share: stats.reportingShare, color: '#4f46e5' },
                      { label: 'Not yet', count: stats.total - stats.reporting, share: 1 - stats.reportingShare, color: '#e2e8f0' },
                    ]}
                    value={pct(stats.reportingShare)}
                    caption="reporting"
                    size={84}
                    thickness={10}
                  />
                  <p class="text-[12px] leading-relaxed text-slate-500">
                    <span class="font-bold text-slate-900">{stats.reporting} of {stats.total}</span> PCs have sent a report from
                    the agent, which fills in CPU, memory, programs, printers and multimedia automatically.
                  </p>
                </div>
              </div>

              <div class={`${card} p-5`}>
                <p class="text-[12px] font-semibold text-slate-700">Multimedia</p>
                {
                  reportedMedia.length === 0 ? (
                    <p class="mt-2 text-[12px] leading-relaxed text-slate-500">
                      Speaker, microphone and camera health appears here once PCs report through the agent.
                    </p>
                  ) : (
                    <ul class="mt-3 grid grid-cols-3 gap-2">
                      {media.map(({ label, Icon, working }) => (
                        <li class="rounded-xl bg-slate-50 p-3 text-center">
                          <Icon size={16} class="mx-auto text-slate-500" />
                          <p class="mt-1.5 text-[16px] font-extrabold tabular-nums text-slate-900">
                            {working}
                            <span class="text-[11px] font-semibold text-slate-400">/{reportedMedia.length}</span>
                          </p>
                          <p class="text-[10.5px] font-medium text-slate-500">{label} OK</p>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>
            </div>
          </div>
        </section>

        <!-- Locations -->
        <section id="locations" class="scroll-mt-20">
          <p class={eyebrow}>Locations</p>
          <h3 class={`${sectionTitle} mt-1`}>Where everything sits</h3>

          <div class="mt-5 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
            {
              locations.map((loc) => (
                <div class={`${card} p-5`}>
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                      <span class="flex h-9 w-9 items-center justify-center rounded-xl text-white" style={`background:${loc.color}`}>
                        <MapPin size={16} />
                      </span>
                      <div class="leading-tight">
                        <p class="text-[14px] font-bold text-slate-900">{loc.label}</p>
                        <p class="text-[11px] text-slate-500">
                          {loc.active} active · {loc.users} assigned
                        </p>
                      </div>
                    </div>
                    <p class="text-[24px] font-extrabold leading-none tabular-nums text-slate-900">{loc.count}</p>
                  </div>

                  <div class="mt-4 flex h-2 w-full overflow-hidden rounded-full bg-slate-100">
                    <span style={`width:${(loc.desktops / loc.count) * 100}%;background:#4f46e5`} title={`${loc.desktops} desktops`} />
                    <span style={`width:${(loc.aios / loc.count) * 100}%;background:#8b5cf6`} title={`${loc.aios} all-in-ones`} />
                    <span style={`width:${(loc.laptops / loc.count) * 100}%;background:#0ea5e9`} title={`${loc.laptops} laptops`} />
                  </div>
                  <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-slate-500">
                    {loc.desktops > 0 && (
                      <li><span class="font-bold text-slate-800">{loc.desktops}</span> desktop{loc.desktops === 1 ? '' : 's'}</li>
                    )}
                    {loc.aios > 0 && (
                      <li><span class="font-bold text-slate-800">{loc.aios}</span> all-in-one{loc.aios === 1 ? '' : 's'}</li>
                    )}
                    {loc.laptops > 0 && (
                      <li><span class="font-bold text-slate-800">{loc.laptops}</span> laptop{loc.laptops === 1 ? '' : 's'}</li>
                    )}
                  </ul>

                  <div class="mt-4 flex flex-wrap gap-1.5 border-t border-slate-100 pt-3">
                    {loc.names.map((name) => (
                      <span class="rounded-md bg-slate-100 px-1.5 py-0.5 font-mono text-[10.5px] text-slate-600">{name}</span>
                    ))}
                    {loc.more > 0 && <span class="px-1 text-[10.5px] font-semibold text-slate-400">+{loc.more} more</span>}
                  </div>
                </div>
              ))
            }
          </div>
        </section>
      </main>

      <footer class="border-t border-slate-200 bg-white px-4 py-4 text-[11.5px] text-slate-400 lg:px-8">
        <div class="mx-auto flex max-w-[1440px] flex-wrap items-center justify-between gap-2">
          <span>PC Register · Office IT · {stats.total} PCs on record</span>
          <span>
            Prefer the sheet? <a href="/" class="font-semibold text-indigo-600 hover:text-indigo-800">Open the classic register</a>
          </span>
        </div>
      </footer>
    </div>

    <RecordDrawer />
    <ListModal />
  </div>

  <script type="application/json" id="pcs-data" set:html={JSON.stringify(pcs)} />

  <script>
    import Alpine from 'alpinejs';
    import dashboardApp from '../scripts/dashboardApp.js';

    window.dashboardApp = dashboardApp;
    window.Alpine = Alpine;
    Alpine.start();
  </script>
</Layout>

<style>
  [x-cloak] {
    display: none !important;
  }
  html {
    scroll-behavior: smooth;
  }
</style>
