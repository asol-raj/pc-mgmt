---
import Layout from '../layouts/Layout.astro';
import TopBar from '../components/TopBar.astro';
import RegisterTable from '../components/RegisterTable.astro';
import DataTable from '../components/DataTable.astro';
import RecordDrawer from '../components/RecordDrawer.astro';
import { MonitorX, ShieldCheck, ClipboardCopy, Check } from '@lucide/astro';
import db from '../lib/db';
import type { Pc } from '../lib/types';

const [rows] = await db.query('SELECT * FROM pcs ORDER BY name ASC');
const pcs = rows as Pc[];
---

<Layout title="PC Register">
  <div class="flex flex-col h-screen overflow-hidden bg-slate-50" x-data="pcApp()" x-cloak>
    <TopBar eyebrow="Office IT" title="PC Register">
      <button
        type="button"
        x-show="view === 'data'"
        x-on:click="copyTsv()"
        title="Copy the visible rows — paste straight into Excel or Google Sheets"
        class="flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1.5 text-[12px] font-semibold text-slate-600 hover:bg-slate-50"
      >
        <ClipboardCopy size={13} x-show="!copied" />
        <Check size={13} x-show="copied" class="text-emerald-600" />
        <span x-text="copied ? 'Copied' : 'Copy'"></span>
      </button>

      <a
        href="/admin"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-lg border border-slate-300 px-2.5 py-1.5 text-[12px] font-semibold text-slate-600 hover:bg-slate-50"
      >
        <ShieldCheck size={13} />
        Admin
      </a>
    </TopBar>

    <main class="flex-1 min-h-0 flex flex-col p-3">
      <template x-if="filtered.length === 0">
        <div class="flex-1 flex flex-col items-center justify-center gap-2 text-center">
          <MonitorX size={26} class="text-slate-300" />
          <p class="text-sm text-slate-500">No PCs match the current search or filters.</p>
          <button type="button" x-on:click="resetFilters()" class="text-[13px] font-semibold text-indigo-600 hover:text-indigo-800">
            Clear everything
          </button>
        </div>
      </template>

      <template x-if="filtered.length > 0 && view === 'register'">
        <RegisterTable />
      </template>

      <template x-if="filtered.length > 0 && view === 'data'">
        <DataTable />
      </template>
    </main>

    <footer class="shrink-0 border-t border-slate-200 bg-white px-4 py-1.5 text-[11px] text-slate-400">
      <span x-show="view === 'register'">
        Click a row to open its full record · Click a column heading to sort · Use Filters for per-column filtering
      </span>
      <span x-show="view === 'data'" x-cloak>
        A plain sheet of every field · Double-click a cell to open the full record · Copy pastes into Excel or Google Sheets
      </span>
    </footer>

    <RecordDrawer />
  </div>

  <script type="application/json" id="pcs-data" set:html={JSON.stringify(pcs)} />

  <script>
    import Alpine from 'alpinejs';
    import pcApp from '../scripts/pcApp.js';

    window.pcApp = pcApp;
    window.Alpine = Alpine;
    Alpine.start();
  </script>
</Layout>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
